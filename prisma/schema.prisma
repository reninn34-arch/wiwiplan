generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlanningStatus {
  DRAFT
  IN_PROGRESS
  REVIEW
  APPROVED
  PUBLISHED
}

enum PostType {
  CARROUSEL
  REEL
  VIDEO
  IMAGE
  STORY
  STATIC
  OTHER
}

enum IdeaPlatform {
  YOUTUBE
  VIMEO
  INSTAGRAM
  TIKTOK
  LINKEDIN
  FACEBOOK
  IMAGE
  OTHER
}

enum IdeaStatus {
  IDEA
  SELECTED
  IN_PRODUCTION
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

/**
 * Naturaleza del movimiento. No todo lo que cierra un saldo es plata que entró:
 * cuando facturas a una empresa te retienen en la fuente y de IVA, así que el
 * cliente transfiere menos de lo facturado y la diferencia es un comprobante de
 * retención, no una deuda. Registrarla como cobro parcial dejaba saldo abierto
 * y le mandaba cobranza a alguien que ya había pagado completo.
 */
enum PaymentKind {
  /** Plata que efectivamente entró. */
  PAYMENT
  /** Retención en la fuente o de IVA: cierra saldo, nunca entra a la cuenta. */
  WITHHOLDING
  /** Descuento, condonación o corrección acordada. */
  ADJUSTMENT
}

/** Qué clase de archivo es. Cada red trata el video distinto de la imagen. */
enum MediaKind {
  IMAGE
  VIDEO
}

/** Redes donde se publica. Distinta de `IdeaPlatform`, que describe de dónde
 * viene una referencia; ésta dice a dónde sale la pieza. */
enum SocialNetwork {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  YOUTUBE
  LINKEDIN
}

/**
 * Cómo sale una publicación en esa cuenta. Es la decisión que parte el trabajo
 * en dos carriles, y depende de algo que no controlamos: Instagram sólo deja
 * publicar por API en cuentas Business/Creator. En las personales no hay forma
 * legítima de que un servidor publique, así que ahí siempre avisa y publicas tú.
 */
enum PublishMode {
  /// Te avisa a la hora y publicas de un toque. Funciona con cualquier cuenta.
  ASSISTED
  /// Sale sola. Necesita cuenta Business/Creator conectada.
  AUTOMATIC
}

/** Categoría del costo, para ver en qué se va la plata de producir el mes. */
enum CostCategory {
  /** Editor, camarógrafo, community, cualquier persona del equipo. */
  TEAM
  /** Pauta publicitaria. */
  ADS
  /** Locación, talento, utilería, viáticos. */
  PRODUCTION
  /** Licencias, software, música. */
  TOOLS
  OTHER
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  PAYPAL
  CRYPTO
  OTHER
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  image     String?
  createdAt DateTime @default(now())

  clients      Client[]
  plannings    Planning[]
  contentIdeas ContentIdea[]
  storyboards  Storyboard[]
  tags         Tag[]
  notifications Notification[]
  pushSubscriptions PushSubscription[]
}

model Client {
  id     String @id @default(cuid())
  name   String
  email  String
  logo   String?
  userId String
  /// Nombre del plan contratado ("Plan Crecimiento"). Vacío = sin plan fijo.
  planName  String @default("")
  /// Tarifa mensual acordada, en centavos. Siembra el valor de cada mes nuevo
  /// para no volver a teclear el mismo número doce veces al año.
  rateCents Int    @default(0)

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  plannings Planning[]
  accounts  ClientAccount[]

  @@index([userId])
}

/**
 * Las redes de un cliente. Se cargan una vez y después cada pieza sólo elige
 * entre ellas, en vez de repetir la lista completa de redes cada vez.
 *
 * Una cuenta por red y por cliente: mantiene el modelo entendible —la red está
 * puesta o no está— a cambio de no soportar dos cuentas de la misma red, que
 * hoy no hace falta.
 */
model ClientAccount {
  id        String        @id @default(cuid())
  clientId  String
  network   SocialNetwork
  /// El usuario sin la arroba: "kibou".
  handle    String        @default("")
  mode      PublishMode   @default(ASSISTED)
  createdAt DateTime      @default(now())

  // ── Conexión con la red, cuando la hay ──
  /// Id de la cuenta en la red (el de Instagram Business, por ejemplo). Es con
  /// lo que se publica, y no cambia aunque el cliente se cambie el usuario.
  externalId      String?
  /// El usuario tal como lo reporta la red al conectar. Sólo para reconocerla.
  externalName    String?
  /// La página de Facebook a la que cuelga la cuenta de Instagram.
  pageId          String?
  /// Token de acceso, **cifrado**. Da permiso para publicar en la cuenta de
  /// otra persona, así que no puede quedar legible en la base.
  accessToken     String?
  /// Cuándo caduca. Los de Meta duran ~60 días y hay que renovarlos antes.
  tokenExpiresAt  DateTime?
  connectedAt     DateTime?

  client  Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  targets IdeaTarget[]

  @@unique([clientId, network])
  @@index([clientId])
}

/**
 * A qué redes sale una pieza. `publishedAt` se marca por red, porque una pieza
 * puede haber salido ya en Instagram y seguir pendiente en TikTok.
 */
model IdeaTarget {
  ideaId      String
  accountId   String
  publishedAt DateTime?

  // ── Estado de la publicación automática ──
  /// Id del contenedor en Meta mientras procesa. Un reel no se publica de una:
  /// se crea el contenedor, Meta lo procesa, y recién ahí se publica. Guardarlo
  /// permite retomar en la siguiente corrida si la función se queda sin tiempo.
  containerId   String?
  /// Id de la publicación ya creada en la red.
  externalPostId String?
  attempts      Int       @default(0)
  attemptedAt   DateTime?
  /// El último error, para poder decir por qué no salió en vez de callarlo.
  lastError     String?

  // ── Cómo le fue, una vez publicada ──
  /// Nulos mientras no se hayan consultado nunca. Se distingue de cero a
  /// propósito: "no lo sabemos" y "no lo vio nadie" no son lo mismo, y
  /// mostrarlos igual sería inventarle un dato al cliente.
  /// Cuentas únicas que la vieron.
  reach       Int?
  likes       Int?
  commentCount Int?
  /// Guardados. En una agencia es la señal más honesta de que algo sirvió.
  saves       Int?
  shares      Int?
  /// Reproducciones. Sólo tiene sentido en video.
  views       Int?
  /// Cuándo se consultaron. Sin esto no se puede decir "hace dos días" ni
  /// saber si vale la pena volver a preguntar.
  metricsAt   DateTime?

  idea    ContentIdea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  account ClientAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([ideaId, accountId])
  @@index([accountId])
}

model Planning {
  id              String          @id @default(cuid())
  title           String          @default("Sin título")
  description     String          @default("")
  period          String          @default("")
  status          PlanningStatus  @default(DRAFT)
  targetAudience  String          @default("")
  goals           String          @default("")
  notes           String          @default("")
  /// Suma cacheada de `costs`, mantenida por `recalcPlanningCost`. Es la otra
  /// mitad del dinero: sin ella el módulo es una planilla de cobros y no hay
  /// forma de saber si un cliente deja margen o se come el mes.
  costCents       Int             @default(0)
  /// Valor del mes: suma de `items` **más** los costos marcados como
  /// recobrables. No se escribe a mano: la mantiene `recalcPlanningMoney`
  /// después de cada cambio. Existe como columna para que el dashboard y los
  /// recordatorios lean el total sin join.
  priceCents      Int             @default(0)
  clientId        String?
  userId          String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  /// Última vez que se envió recordatorio de saldo al cliente (anti-spam).
  reminderSentAt  DateTime?

  client          Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  shareLinks      ShareLink[]
  contentIdeas    ContentIdea[]
  storyboards     Storyboard[]
  payments        Payment[]
  installments    PaymentInstallment[]
  items           PlanningItem[]
  costs           PlanningCost[]

  @@index([userId])
}

/**
 * Líneas del valor del mes: los honorarios del plan más los extras que se
 * acuerdan sobre la marcha (una sesión de fotos, una pieza fuera de paquete).
 * Guardarlas por separado es lo que permite que dentro de tres meses se sepa
 * de dónde salió el total, y que el recibo lo pueda desglosar.
 */
model PlanningItem {
  id          String   @id @default(cuid())
  planningId  String
  label       String   @default("")
  amountCents Int
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  planning Planning @relation(fields: [planningId], references: [id], onDelete: Cascade)

  @@index([planningId])
}

/**
 * Lo que costó producir el mes: el editor, la pauta, el fotógrafo, la música.
 * `Planning.costCents` es la suma cacheada de estas filas, igual que
 * `priceCents` lo es de `items`.
 *
 * La pauta que le recobras al cliente no necesita marca especial: si la cargas
 * como línea del valor **y** como costo, entra y sale, y el margen no se mueve.
 * Que es exactamente lo correcto.
 */
model PlanningCost {
  id          String       @id @default(cuid())
  planningId  String
  label       String       @default("")
  amountCents Int
  category    CostCategory @default(OTHER)
  /// Se le recobra al cliente: el costo entra también al valor del mes y sale
  /// en la factura como línea propia. Suma igual de los dos lados, así que el
  /// margen no se mueve —que es exactamente lo correcto— y no hay que cargar
  /// la pauta dos veces a mano.
  billable    Boolean      @default(false)
  order       Int          @default(0)
  createdAt   DateTime     @default(now())

  planning Planning @relation(fields: [planningId], references: [id], onDelete: Cascade)

  @@index([planningId])
}

/**
 * Fechas de cobro esperadas del plan (ej.: una cuota por semana). El saldo
 * real se sigue calculando con los pagos registrados; las cuotas sólo marcan
 * cuándo corresponde pedir la plata y alimentan el recordatorio automático.
 */
model PaymentInstallment {
  id          String   @id @default(cuid())
  planningId  String
  label       String   @default("")
  amountCents Int
  dueDate     DateTime

  planning Planning @relation(fields: [planningId], references: [id], onDelete: Cascade)

  @@index([planningId])
}

model Tag {
  id    String @id @default(cuid())
  name  String
  color String @default("#6366f1")
  userId String

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentIdeaTags ContentIdeaTag[]

  @@unique([name, userId])
  @@index([userId])
}

model ContentIdea {
  id              String       @id @default(cuid())
  planningId      String
  title           String
  description     String       @default("")
  pilar           String       @default("")
  postType        PostType     @default(OTHER)
  platform        IdeaPlatform @default(OTHER)
  /// El texto que va en la publicación. Distinto de `description`, que es el
  /// brief —de qué trata la pieza—: el copy suele escribirse después, cerca de
  /// la fecha, y es lo que se copia y pega en la red.
  caption         String       @default("")
  referenceUrl    String       @default("")
  referenceEmbed  String       @default("")
  status          IdeaStatus   @default(IDEA)
  priority        Priority     @default(MEDIUM)
  order           Int          @default(0)
  /// El día en que sale. El calendario del mes se arma con esto.
  dueDate         DateTime?
  /// La hora del reloj, "09:00". Aparte de la fecha a propósito: el día es un
  /// día de calendario y la hora es hora local, así ninguna zona horaria puede
  /// correr una publicación al día anterior.
  publishTime     String       @default("")
  /// Cuándo se avisó que llegaba su hora. Existe para que el barrido no vuelva
  /// a avisar de lo mismo cada vez que corre.
  notifiedAt      DateTime?
  createdAt       DateTime     @default(now())

  planning Planning      @relation(fields: [planningId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [createdBy], references: [id])
  createdBy String
  contentIdeaTags ContentIdeaTag[]
  comments Comment[]
  images ContentIdeaImage[]
  media MediaAsset[]
  targets IdeaTarget[]
  storyboard Storyboard? @relation(fields: [storyboardId], references: [id])
  storyboardId String?

  @@index([planningId])
}

/**
 * El archivo final que se va a publicar. Distinto de `ContentIdeaImage`, que
 * son referencias para reconocer la pieza: esto es lo que sale al aire.
 *
 * Vive en almacenamiento de objetos y no en la base por dos razones. Un reel
 * de 80MB en Postgres no es viable, y sobre todo: Meta **no recibe el archivo**,
 * le das una URL pública y él la descarga. Sin una URL así no hay publicación
 * automática posible.
 */
model MediaAsset {
  id          String    @id @default(cuid())
  ideaId      String
  /// URL pública. Es la que se le pasa a Meta para que descargue el archivo.
  url         String
  /// Ruta dentro del almacenamiento, necesaria para poder borrarlo después.
  /// Única a propósito: registrar el archivo es idempotente, así da igual si lo
  /// confirma el navegador o el aviso del almacenamiento —o los dos.
  pathname    String    @unique
  kind        MediaKind
  contentType String
  sizeBytes   Int
  /// Orden dentro del carrusel. Para una pieza de un solo archivo siempre es 0.
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  idea ContentIdea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
}

model ContentIdeaImage {
  id        String   @id @default(cuid())
  ideaId    String
  dataUrl   String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  idea ContentIdea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
}

/** Configuración global de la app (clave → valor): credenciales de email, etc. */
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ContentIdeaTag {
  contentIdeaId String
  tagId         String

  contentIdea ContentIdea @relation(fields: [contentIdeaId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contentIdeaId, tagId])
}

model Comment {
  id        String   @id @default(cuid())
  contentIdeaId String
  authorName String  @default("Cliente")
  text      String
  createdAt DateTime @default(now())

  contentIdea ContentIdea @relation(fields: [contentIdeaId], references: [id], onDelete: Cascade)

  @@index([contentIdeaId])
}

model Storyboard {
  id          String   @id @default(cuid())
  planningId  String
  title       String   @default("Storyboard")
  description String   @default("")
  createdAt   DateTime @default(now())

  planning Planning         @relation(fields: [planningId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [createdBy], references: [id])
  createdBy String
  panels   StoryboardPanel[]
  contentIdeas ContentIdea[]

  @@index([planningId])
}

model StoryboardPanel {
  id           String   @id @default(cuid())
  storyboardId String
  sceneNumber  Int
  imageUrl     String   @default("")
  description  String   @default("")
  duration     String   @default("")
  notes        String   @default("")
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  storyboard Storyboard @relation(fields: [storyboardId], references: [id], onDelete: Cascade)

  @@index([storyboardId])
}

/**
 * Un dispositivo al que avisar. Se guarda una fila por navegador que dio
 * permiso: el mismo usuario en el teléfono y en la computadora son dos.
 *
 * El `endpoint` lo emite el navegador y es la dirección a la que se manda el
 * aviso; cuando el navegador lo revoca, el envío responde 404 o 410 y la fila
 * se borra sola.
 */
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  /// Para que la persona reconozca cuál es cuál al desconectarlos.
  label     String   @default("")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("comment")
  title     String
  message   String
  link      String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model Payment {
  id         String        @id @default(cuid())
  planningId String
  amountCents Int
  kind       PaymentKind   @default(PAYMENT)
  method     PaymentMethod @default(TRANSFER)
  note       String        @default("")
  paidAt     DateTime      @default(now())
  createdAt  DateTime      @default(now())

  planning Planning @relation(fields: [planningId], references: [id], onDelete: Cascade)

  @@index([planningId])
}

model ShareLink {
  id          String        @id @default(cuid())
  token       String        @unique
  planningId  String
  expiresAt   DateTime?
  createdAt   DateTime      @default(now())

  planning Planning @relation(fields: [planningId], references: [id], onDelete: Cascade)

  @@index([token])
  /// Uno por plan, garantizado por la base. Generar de nuevo reemplaza al
  /// anterior; sin esta restricción, un fallo en el código volvía a dejar el
  /// mismo plan repartido en varias direcciones vivas a la vez.
  @@unique([planningId])
}
