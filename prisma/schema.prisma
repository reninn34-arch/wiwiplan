generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlanningStatus {
  DRAFT
  IN_PROGRESS
  REVIEW
  APPROVED
  PUBLISHED
}

enum PostType {
  CARROUSEL
  REEL
  VIDEO
  IMAGE
  STORY
  STATIC
  OTHER
}

enum IdeaPlatform {
  YOUTUBE
  VIMEO
  INSTAGRAM
  TIKTOK
  LINKEDIN
  FACEBOOK
  IMAGE
  OTHER
}

enum IdeaStatus {
  IDEA
  SELECTED
  IN_PRODUCTION
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

/**
 * Naturaleza del movimiento. No todo lo que cierra un saldo es plata que entró:
 * cuando facturas a una empresa te retienen en la fuente y de IVA, así que el
 * cliente transfiere menos de lo facturado y la diferencia es un comprobante de
 * retención, no una deuda. Registrarla como cobro parcial dejaba saldo abierto
 * y le mandaba cobranza a alguien que ya había pagado completo.
 */
enum PaymentKind {
  /** Plata que efectivamente entró. */
  PAYMENT
  /** Retención en la fuente o de IVA: cierra saldo, nunca entra a la cuenta. */
  WITHHOLDING
  /** Descuento, condonación o corrección acordada. */
  ADJUSTMENT
}

/** Categoría del costo, para ver en qué se va la plata de producir el mes. */
enum CostCategory {
  /** Editor, camarógrafo, community, cualquier persona del equipo. */
  TEAM
  /** Pauta publicitaria. */
  ADS
  /** Locación, talento, utilería, viáticos. */
  PRODUCTION
  /** Licencias, software, música. */
  TOOLS
  OTHER
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  PAYPAL
  CRYPTO
  OTHER
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  image     String?
  createdAt DateTime @default(now())

  clients      Client[]
  plannings    Planning[]
  contentIdeas ContentIdea[]
  storyboards  Storyboard[]
  tags         Tag[]
  notifications Notification[]
}

model Client {
  id     String @id @default(cuid())
  name   String
  email  String
  logo   String?
  userId String
  /// Nombre del plan contratado ("Plan Crecimiento"). Vacío = sin plan fijo.
  planName  String @default("")
  /// Tarifa mensual acordada, en centavos. Siembra el valor de cada mes nuevo
  /// para no volver a teclear el mismo número doce veces al año.
  rateCents Int    @default(0)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  plannings Planning[]

  @@index([userId])
}

model Planning {
  id              String          @id @default(cuid())
  title           String          @default("Sin título")
  description     String          @default("")
  period          String          @default("")
  status          PlanningStatus  @default(DRAFT)
  targetAudience  String          @default("")
  goals           String          @default("")
  notes           String          @default("")
  /// Suma cacheada de `costs`, mantenida por `recalcPlanningCost`. Es la otra
  /// mitad del dinero: sin ella el módulo es una planilla de cobros y no hay
  /// forma de saber si un cliente deja margen o se come el mes.
  costCents       Int             @default(0)
  /// Valor del mes: suma de `items` **más** los costos marcados como
  /// recobrables. No se escribe a mano: la mantiene `recalcPlanningMoney`
  /// después de cada cambio. Existe como columna para que el dashboard y los
  /// recordatorios lean el total sin join.
  priceCents      Int             @default(0)
  clientId        String?
  userId          String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  /// Última vez que se envió recordatorio de saldo al cliente (anti-spam).
  reminderSentAt  DateTime?

  client          Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  shareLinks      ShareLink[]
  contentIdeas    ContentIdea[]
  storyboards     Storyboard[]
  payments        Payment[]
  installments    PaymentInstallment[]
  items           PlanningItem[]
  costs           PlanningCost[]

  @@index([userId])
}

/**
 * Líneas del valor del mes: los honorarios del plan más los extras que se
 * acuerdan sobre la marcha (una sesión de fotos, una pieza fuera de paquete).
 * Guardarlas por separado es lo que permite que dentro de tres meses se sepa
 * de dónde salió el total, y que el recibo lo pueda desglosar.
 */
model PlanningItem {
  id          String   @id @default(cuid())
  planningId  String
  label       String   @default("")
  amountCents Int
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  planning Planning @relation(fields: [planningId], references: [id], onDelete: Cascade)

  @@index([planningId])
}

/**
 * Lo que costó producir el mes: el editor, la pauta, el fotógrafo, la música.
 * `Planning.costCents` es la suma cacheada de estas filas, igual que
 * `priceCents` lo es de `items`.
 *
 * La pauta que le recobras al cliente no necesita marca especial: si la cargas
 * como línea del valor **y** como costo, entra y sale, y el margen no se mueve.
 * Que es exactamente lo correcto.
 */
model PlanningCost {
  id          String       @id @default(cuid())
  planningId  String
  label       String       @default("")
  amountCents Int
  category    CostCategory @default(OTHER)
  /// Se le recobra al cliente: el costo entra también al valor del mes y sale
  /// en la factura como línea propia. Suma igual de los dos lados, así que el
  /// margen no se mueve —que es exactamente lo correcto— y no hay que cargar
  /// la pauta dos veces a mano.
  billable    Boolean      @default(false)
  order       Int          @default(0)
  createdAt   DateTime     @default(now())

  planning Planning @relation(fields: [planningId], references: [id], onDelete: Cascade)

  @@index([planningId])
}

/**
 * Fechas de cobro esperadas del plan (ej.: una cuota por semana). El saldo
 * real se sigue calculando con los pagos registrados; las cuotas sólo marcan
 * cuándo corresponde pedir la plata y alimentan el recordatorio automático.
 */
model PaymentInstallment {
  id          String   @id @default(cuid())
  planningId  String
  label       String   @default("")
  amountCents Int
  dueDate     DateTime

  planning Planning @relation(fields: [planningId], references: [id], onDelete: Cascade)

  @@index([planningId])
}

model Tag {
  id    String @id @default(cuid())
  name  String
  color String @default("#6366f1")
  userId String

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentIdeaTags ContentIdeaTag[]

  @@unique([name, userId])
  @@index([userId])
}

model ContentIdea {
  id              String       @id @default(cuid())
  planningId      String
  title           String
  description     String       @default("")
  pilar           String       @default("")
  postType        PostType     @default(OTHER)
  platform        IdeaPlatform @default(OTHER)
  referenceUrl    String       @default("")
  referenceEmbed  String       @default("")
  status          IdeaStatus   @default(IDEA)
  priority        Priority     @default(MEDIUM)
  order           Int          @default(0)
  dueDate         DateTime?
  createdAt       DateTime     @default(now())

  planning Planning      @relation(fields: [planningId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [createdBy], references: [id])
  createdBy String
  contentIdeaTags ContentIdeaTag[]
  comments Comment[]
  images ContentIdeaImage[]
  storyboard Storyboard? @relation(fields: [storyboardId], references: [id])
  storyboardId String?

  @@index([planningId])
}

model ContentIdeaImage {
  id        String   @id @default(cuid())
  ideaId    String
  dataUrl   String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  idea ContentIdea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
}

/** Configuración global de la app (clave → valor): credenciales de email, etc. */
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ContentIdeaTag {
  contentIdeaId String
  tagId         String

  contentIdea ContentIdea @relation(fields: [contentIdeaId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contentIdeaId, tagId])
}

model Comment {
  id        String   @id @default(cuid())
  contentIdeaId String
  authorName String  @default("Cliente")
  text      String
  createdAt DateTime @default(now())

  contentIdea ContentIdea @relation(fields: [contentIdeaId], references: [id], onDelete: Cascade)

  @@index([contentIdeaId])
}

model Storyboard {
  id          String   @id @default(cuid())
  planningId  String
  title       String   @default("Storyboard")
  description String   @default("")
  createdAt   DateTime @default(now())

  planning Planning         @relation(fields: [planningId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [createdBy], references: [id])
  createdBy String
  panels   StoryboardPanel[]
  contentIdeas ContentIdea[]

  @@index([planningId])
}

model StoryboardPanel {
  id           String   @id @default(cuid())
  storyboardId String
  sceneNumber  Int
  imageUrl     String   @default("")
  description  String   @default("")
  duration     String   @default("")
  notes        String   @default("")
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  storyboard Storyboard @relation(fields: [storyboardId], references: [id], onDelete: Cascade)

  @@index([storyboardId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("comment")
  title     String
  message   String
  link      String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model Payment {
  id         String        @id @default(cuid())
  planningId String
  amountCents Int
  kind       PaymentKind   @default(PAYMENT)
  method     PaymentMethod @default(TRANSFER)
  note       String        @default("")
  paidAt     DateTime      @default(now())
  createdAt  DateTime      @default(now())

  planning Planning @relation(fields: [planningId], references: [id], onDelete: Cascade)

  @@index([planningId])
}

model ShareLink {
  id          String        @id @default(cuid())
  token       String        @unique
  planningId  String
  expiresAt   DateTime?
  createdAt   DateTime      @default(now())

  planning Planning @relation(fields: [planningId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([planningId])
}
